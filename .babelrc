{
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": {
          "node": "current"
        }
      }
    ]
  ],
  "plugins": [
    // 1. **NEW:** Metadata plugin must be the first plugin!
    "babel-plugin-transform-typescript-metadata",

    // 2. Decorators must come AFTER metadata and use "legacy": true
    ["@babel/plugin-proposal-decorators", { "legacy": true }],

    // 3. Class Properties must come after decorators and use "loose": true
    ["@babel/plugin-proposal-class-properties", { "loose": true }]
  ]
}
