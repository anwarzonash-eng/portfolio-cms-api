# Copy this file to .env and fill in your own values. Never commit .env.

PORT=5000
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL connection string (Sequelize)
DB_String=postgres://USER:PASSWORD@localhost:5432/DATABASE

# Initial admin account created on first run
adminUser=admin
adminEmail=admin@example.com
adminPassword=change-me

# AWS S3 (photo / file uploads)
aws_region=us-east-1
Bucket=your-bucket-name
aws_access_key=your-aws-access-key-id
aws_secert_access_key=your-aws-secret-access-key

# Gmail OAuth2 (used by the "send email with attachment" endpoint)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token
MAIL_SENDER=you@example.com
